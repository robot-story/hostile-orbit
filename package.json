{
  "name": "hostile-orbit",
  "version": "1.0.0",
  "author": "Meridian Commonwealth Orbital Assault Division",
  "private": true,
  "type": "module",
  "description": "HOSTILE ORBIT - neon military sci-fi third-person shooter",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "node tools/clean-dist.mjs && vite build",
    "preview": "vite preview --port 4173",
    "gen:audio": "node tools/generate-audio.mjs",
    "gen:voice": "node tools/generate-voice.mjs",
    "gen:all": "node tools/generate-audio.mjs && node tools/generate-voice.mjs",
    "desktop": "electron .",
    "package": "node tools/clean-dist.mjs && vite build && electron-builder --win portable --config electron-builder.json"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "lamejs": "^1.2.1",
    "vite": "^5.4.21"
  },
  "main": "electron/main.cjs"
}
